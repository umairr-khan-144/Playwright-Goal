# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file (it is gitignored).

# Base URL of the application under test (UI)
BASE_URL=https://automationexercise.com

# Base URL of the REST API under test
API_BASE_URL=https://automationexercise.com/api

# Default per-action timeout (ms)
DEFAULT_TIMEOUT=30000

# Run browsers headless (true/false)
HEADLESS=true

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info

# Set automatically by CI runners; keep false for local runs
CI=false
